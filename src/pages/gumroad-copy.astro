---
import BaseLayout from '../layouts/BaseLayout.astro';
import MarketingSection from '../components/MarketingSection.astro';
import CtaButton from '../components/CtaButton.astro';
---

<BaseLayout
  title="Gumroad Product Copy"
  description="Gumroad-ready product copy for Claude Cowork for CPAs: Busy-Season Workflow Kit."
>
  <section class="hero-card compact">
    <p class="eyebrow">Gumroad-Ready Copy</p>
    <h1>Claude Cowork for CPAs: Busy-Season Workflow Kit</h1>
    <p class="hero-lead">
      A practical digital toolkit for solo CPAs and small firms that want Claude for drafting, summaries, handoffs,
      and workflow cleanup during busy season, without fake authority or AI chaos.
    </p>
  </section>

  <MarketingSection title="Subtitle">
    <p>
      A practical digital toolkit for solo CPAs and small firms that want to use Claude for drafting, summaries,
      handoffs, and workflow cleanup during busy season while keeping human judgment in charge.
    </p>
  </MarketingSection>

  <MarketingSection title="Short Description">
    <p>
      Use Claude like a safe junior coworker inside your CPA firm. This kit gives you copy/paste prompts,
      review checklists, guardrails, and rollout guidance to save time on repetitive writing and admin drag.
    </p>
  </MarketingSection>

  <MarketingSection title="What Is Included">
    <ul class="check-list">
      <li>Start Here guide</li>
      <li>Busy-Season Workflow Playbook</li>
      <li>25 Claude prompts for CPAs</li>
      <li>CPA-safe usage rules</li>
      <li>Human review checklist</li>
      <li>Red / Yellow / Green use-case guide</li>
      <li>One-hour rollout plan</li>
      <li>Bonus templates for client emails, handoffs, recaps, and issue summaries</li>
    </ul>
  </MarketingSection>

  <MarketingSection title="Who This Is For">
    <ul class="check-list">
      <li>Solo CPAs and small CPA firms</li>
      <li>Tax-heavy firms and owner-operators</li>
      <li>Teams already testing Claude but doing it inconsistently</li>
    </ul>
  </MarketingSection>

  <MarketingSection title="Who This Is Not For">
    <ul class="check-list">
      <li>Anyone looking for tax advice</li>
      <li>Firms trying to replace human review</li>
      <li>AI transformation theater projects</li>
      <li>Buyers who want 500 random prompts and no judgment</li>
    </ul>
  </MarketingSection>

  <MarketingSection title="Expected Outcome">
    <p>
      Save time the same week you buy this. Replace random AI usage with a practical system your firm can actually follow.
    </p>
  </MarketingSection>

  <MarketingSection title="Format">
    <p>Digital download. Markdown/PDF-style assets you can read, copy, adapt, and use immediately.</p>
  </MarketingSection>

  <MarketingSection title="Pricing">
    <ul class="check-list">
      <li><strong>Founder price: $99</strong> for the first 20 buyers</li>
      <li><strong>Launch price: $149</strong> after founder spots are claimed</li>
      <li>One-time purchase, no subscription</li>
    </ul>
  </MarketingSection>

  <MarketingSection title="FAQ">
    <div class="faq-grid">
      <article>
        <h3>Is this tax advice?</h3>
        <p>No. It is a workflow kit for drafting, summarizing, organizing, and prep.</p>
      </article>
      <article>
        <h3>Does this replace CPA judgment?</h3>
        <p>No. Humans still review everything.</p>
      </article>
      <article>
        <h3>Do I need to be technical?</h3>
        <p>No. If you can copy, paste, and review output, you can use this.</p>
      </article>
      <article>
        <h3>Can staff use it too?</h3>
        <p>Yes. A shared operating standard is one of the core outcomes.</p>
      </article>
    </div>
    <div class="final-cta">
      <CtaButton href="#" label="Get the Busy-Season Workflow Kit" />
    </div>
  </MarketingSection>
</BaseLayout>
